# Public site origin, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional analytics identifier. Leave empty to disable analytics.
NEXT_PUBLIC_ANALYTICS_ID=

# Optional. Enables real AI-generated search summaries via GPT-5 mini. Search
# works correctly without this — it falls back to a rule-based interpreter —
# so leave it unset until you are ready to pay for API usage.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-5-mini
