# Public site origin, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Enables Google Analytics 4 (page views, traffic sources, device
# type) when set. Leave empty and analytics is fully absent — no script tag,
# no request to Google, no cost. Get a Measurement ID (format G-XXXXXXXXXX)
# by creating a GA4 property at https://analytics.google.com
# Update the Privacy Policy if you turn this on — it is already disclosed
# there, but confirm it against whatever you actually enable in GA4 itself
# (e.g. if you later add conversion/event tracking beyond page views).
NEXT_PUBLIC_ANALYTICS_ID=

# Optional. Enables real AI-generated search summaries via GPT-5 mini. Search
# works correctly without this — it falls back to a rule-based interpreter —
# so leave it unset until you are ready to pay for API usage.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-5-mini

# Optional, but this is what monetises the site. With it set, every offer in
# data/offers.ts that has a `retailerUrl` (a plain retailer product link) is
# converted into a tracked affiliate link automatically while the site builds
# — so adding a product needs no manual link conversion. It also enables the
# /admin/convert-link page for one-off conversions.
#
# Without it, nothing breaks: offers fall back to their raw retailer link,
# un-monetised, and the build logs which ones fell back.
#
# Get a scoped key (needs the "Create links" / write:links permission) from
# Cuelinks -> Resource Center -> API Key. Never commit the real value — paste
# it into Vercel's Environment Variables instead.
CUELINKS_API_KEY=
